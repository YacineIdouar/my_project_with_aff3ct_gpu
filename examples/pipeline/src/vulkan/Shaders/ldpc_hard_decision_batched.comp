#version 450
/*
GLSL port of hard_decision_kernel in ../../cuda/Decoder_LDPC_cuda_batched_kernel.cu: ldpc_hard_decision.comp with the
frame as work group y.
*/

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer LlrTotalBuf
{
    float data[];
}
llr_total;

layout(set = 0, binding = 1) writeonly buffer BitsBuf
{
    int data[];
}
bits;

layout(push_constant) uniform PushConstants
{
    uint block_length;
    uint total_stride; // frame stride of 'llr_total'
    uint bits_stride;  // frame stride of 'bits' (the socket's)
}
pc;

void
main()
{
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= pc.block_length) return;
    uint f = gl_WorkGroupID.y;
    bits.data[f * pc.bits_stride + tid] = (llr_total.data[f * pc.total_stride + tid] < 0.0) ? 1 : 0;
}
